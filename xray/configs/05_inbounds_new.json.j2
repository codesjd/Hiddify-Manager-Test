{
    "inbounds":[
        {% for protocol in ['vless','vmess','trojan']%}
            {%for stream in ['xhttp','ws','grpc','tcp','httpupgrade']%}
                {# Xray always serves these regardless of core_type - sing-box
                   no longer renders its own competing inbounds for them (see
                   singbox/configs/05_inbounds_new.json.j2), so an xray-only
                   client can always use vless/vmess/trojan over any of these
                   transports, whichever core is primary. core_type still
                   gates protocols that genuinely need a specific core (e.g.
                   REALITY tcp+vision binds a single physical port directly,
                   so exactly one side may claim it). #}
                {% if hconfigs[protocol~'_enable'] and hconfigs[stream~'_enable'] %}
                    {
                    "tag":"v10-{{protocol}}-{{stream}}",
                    "listen": "@@v10-{{protocol}}-{{stream}}", 
                    {% include '/opt/hiddify-manager/xray/configs/common/protocols/'~protocol~'.pj2' %},
                    
                    "streamSettings": {
                        {% with path=hconfigs['path_'~ protocol]~hconfigs['path_'~stream] %}
                            {% include '/opt/hiddify-manager/xray/configs/common/streams/'~stream~'.pj2' %},
                        {%endwith %}
                        
                        "security": "none",
                        "sockopt": {
                            "acceptProxyProtocol": true,
                            "tcpFastOpen": true,
                            {# haproxy already hands Xray the real client IP via
                               acceptProxyProtocol above, so an X-Forwarded-For
                               header on the HTTP-layer transports (xhttp/ws/
                               httpupgrade) is never needed to identify the
                               client - it could only be spoofed by whoever's
                               allowed to talk to haproxy. Xray's own startup
                               warning ("has not configured trustedXForwardedFor
                               ... still trusts X-Forwarded-For implicitly") is
                               about exactly this gap; an explicit empty list
                               disables that implicit trust instead of silently
                               honoring a header nothing here relies on. #}
                            "trustedXForwardedFor": []
                        }
                    },

                    "sniffing": {
                        "enabled": true,
                        "destOverride": ["http","tls", "quic"]
                    }
                },
                {%endif%}
            {%endfor%}
        {%endfor%}
    ]
}