{# Not gated by core_type - see 05_inbounds_05_xdns.json.j2's comment;
   Xray always runs regardless of core_type, and xicmp has no sing-box
   equivalent at all. #}
{
    "inbounds": [
        {% for d in domains if d['mode']=='xicmp' %}
            {% set port = d['internal_port_xicmp'] %}
            {
                "tag": "xicmpin_{{port}}",
                {# ICMP has no ports - the raw socket xicmp opens is bound by
                   its own "ip" mask setting below, not by listen/port here.
                   listen/port only exist to satisfy Xray's InboundConfig
                   schema and give this inbound a unique tag/log identity. #}
                "listen": "127.0.0.1",
                "port": {{port}},
                {% set protocol='vless' %}
                {% with flow="" %}
                    {% include '/opt/hiddify-manager/xray/configs/common/protocols/'~protocol~'.pj2' %},
                {% endwith %}
                "streamSettings": {
                    "network": "mkcp",
                    "kcpSettings": {
                        "mtu": 1200,
                        "tti": 20,
                        "uplinkCapacity": 5,
                        "downlinkCapacity": 20,
                        "congestion": false
                    },
                    "finalmask": {
                        "udp": [
                            {
                                "type": "xicmp",
                                "settings": {
                                    {# Hardcoded, not admin-configurable - see
                                       DomainAdmin.py's comment on the retired
                                       xicmp_dgram field. Xray runs as root
                                       here, so the real raw socket is always
                                       available and always correct. #}
                                    "dgram": false,
                                    "ip": "0.0.0.0",
                                    "id": {{d['xicmp_id']}}
                                }
                            }
                        ]
                    }
                },
                "sniffing": {
                    "enabled": false
                }
            },
        {% endfor %}
    ]
}
