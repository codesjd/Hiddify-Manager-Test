{# Not gated by core_type - see 05_inbounds_05_xdns.json.j2's comment;
   Xray always runs regardless of core_type, and xicmp has no sing-box
   equivalent at all. #}
{
    "inbounds": [
        {% for d in domains if d['mode']=='xicmp' %}
            {% set port = d['internal_port_xicmp'] %}
            {
                "tag": "xicmpin_{{port}}",
                {# ICMP has no ports - the raw socket xicmp opens is bound by
                   its own "listenIp" mask setting below, not by listen/port
                   here. listen/port only exist to satisfy Xray's
                   InboundConfig schema and give this inbound a unique
                   tag/log identity. #}
                "listen": "127.0.0.1",
                "port": {{port}},
                {% set protocol='vless' %}
                {% with flow="" %}
                    {% include '/opt/hiddify-manager/xray/configs/common/protocols/'~protocol~'.pj2' %},
                {% endwith %}
                "streamSettings": {
                    "network": "mkcp",
                    "kcpSettings": {
                        "mtu": 1200,
                        "tti": 20,
                        "uplinkCapacity": 5,
                        "downlinkCapacity": 20,
                        "congestion": false
                    },
                    {# Real Xray-core JSON schema (infra/conf/transport_internet.go's
                       Xicmp struct, verified against v26.3.27 source):
                       "listenIp" (not "ip") and "id" only - there is no
                       "dgram" field in this Xray version's config schema at
                       all, so it's not something either side can configure. #}
                    "finalmask": {
                        "udp": [
                            {
                                "type": "xicmp",
                                "settings": {
                                    "listenIp": "0.0.0.0",
                                    "id": {{d['xicmp_id']}}
                                }
                            }
                        ]
                    }
                },
                "sniffing": {
                    "enabled": false
                }
            },
        {% endfor %}
    ]
}
