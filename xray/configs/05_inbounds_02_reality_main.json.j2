{% if hconfigs['core_type']=="xray" %}
	{%set modes={'special_reality_tcp':'tcp','special_reality_grpc':'grpc','special_reality_xhttp':'xhttp'}%}
{%else%}
	{%set modes={'special_reality_xhttp':'xhttp'}%}
{%endif%}
{
	{% if hconfigs['reality_enable'] %}
		"inbounds": [
			{% for d in domains if d['internal_port_special'] and d['mode'] in  modes  %}
				{%set domain=d['domain']%}
				{%set port=d['internal_port_special']%}
				{%set protocol='vless'%}
				{%set stream=modes[d['mode']]%}
			{
				"tag":"realityin_{{stream}}_{{port}}",
				{% if stream=='tcp' %}
				{# REALITY's server-side validation races the decoy site's real
				   TLS response against local ClientHello auth (see
				   github.com/xtls/reality's Server()) - whichever finishes
				   first wins, and the loser (when it's local validation) is
				   exactly what produces "received real certificate" on the
				   client. Routing through HAProxy's SNI frontend adds an
				   extra hop + PROXY-protocol-header parse before Xray even
				   starts on the ClientHello, widening that race window on
				   top of the TCP fragmentation already caused by the
				   mandatory post-quantum key share. Binding tcp+vision
				   REALITY directly (same pattern already used for
				   tuic/hysteria2/anytls, all of which bypass HAProxy too)
				   removes that hop entirely. grpc/xhttp reality still goes
				   through HAProxy's HTTP-level dispatch below since they
				   don't have this specific race concern. #}
				"listen": "::",
				"port": {{port}},
				{%else%}
				// "port": {{port}}, // This is TLS entrypoint. This entrypoint does the SSL Termination then routes the request based on the Path or ALPN type.
				"listen": "@@realityin_{{port}}",
				{%endif%}

				{% with flow="xtls-rprx-vision" if stream=='tcp' else "" %}
					{% include '/opt/hiddify-manager/xray/configs/common/protocols/'~protocol~'.pj2' %},
				{%endwith%}


				"streamSettings": {
					{% if stream!='tcp' %}
						{% with path=hconfigs['path_'~ protocol]~hconfigs['path_'~stream] %}
                            {% include '/opt/hiddify-manager/xray/configs/common/streams/'~stream~'.pj2' %},
                        {%endwith %}
                        {%endif%}
                        "security": "reality",
						"realitySettings": {
							"show": {%if hconfigs['log_level']=="DEBUG"%} true {%else%}false{%endif%},
							"dest": "{{domain}}:443",
							"xver": 0,
							"serverNames": [
								"{{domain}}"
							],
							"privateKey": "{{d['reality_private_key']}}",
							"shortIds": [
								""
								{%for sid in d['reality_short_id'].split(',') %}
								,"{{sid}}"
								{%endfor%}
							],
							{# maxTimeDiff/limitFallback* were entirely unset (Xray-core
							   defaults: maxTimeDiff=0, meaning NO replay-window check at
							   all - a captured ClientHello never expires). sing-box's own
							   REALITY inbound (singbox/configs/05_inbounds_2061_reality_
							   main.json.j2) already sets max_time_difference: 2h - matching
							   that value here instead of picking a new one keeps the two
							   backends' REALITY hardening consistent rather than trading
							   one inconsistency for another. limitFallback* throttles
							   unauthenticated/decoy-routed traffic (anyone who fails
							   REALITY's ClientHello check and gets routed to the real
							   dest's TLS response instead) so the fallback path is
							   unattractive to use as a free proxy, without affecting any
							   real authenticated client. #}
							"maxTimeDiff": 7200000,
							"limitFallbackUpload": {"afterBytes": 0, "bytesPerSec": 1000000, "burstBytesPerSec": 2000000},
							"limitFallbackDownload": {"afterBytes": 0, "bytesPerSec": 1000000, "burstBytesPerSec": 2000000}
						},
                        "sockopt": {
                            {% if stream=='tcp' %}
                            "acceptProxyProtocol": false,
                            {%else%}
                            "acceptProxyProtocol": true,
                            {%endif%}
                            "tcpFastOpen": true
                        }
                    },

                    "sniffing": {
                        "enabled": true,
                        "destOverride": ["http","tls", "quic"]
                    }
					
					
			},
			{%endfor%}	  
		]
	{% endif %}
}
