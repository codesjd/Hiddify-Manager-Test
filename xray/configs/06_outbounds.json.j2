{
  "outbounds": [
    {
      {%if hconfigs["only_ipv4"]%}
      "domainStrategy":"UseIPv4v6",
      {%endif%}
      "tag": "freedom",
      "protocol": "freedom",
      "settings": {

      }
    },
    {
      "protocol": "blackhole",
      "tag": "blackhole"
    },
    { //do not change the following line since it will be replaced.
      "tag": "forbidden_sites",
      "protocol": "{% if hconfigs['block_iran_sites'] %}blackhole{% else %}freedom{%endif%}"
    },
    // {
    //   "tag": "forbidden_sites", "protocol": "blackhole",
    //   "settings": {
    //     "domainStrategy": "UseIPv4"
    //   },
    //   "sendThrough": "172.16.0.2"
    // },
    // WARP: add an Outbound on the Outbounds admin page instead (Protocol
    // "amneziawg", address=engage.cloudflareclient.com, port=2408,
    // uuid_or_password=<your WireGuard private key>,
    // peer_public_key=bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo= (Cloudflare's
    // well-known WARP public key), local_address=<your WARP-assigned IPv4/32,
    // IPv6/128>, and Jc/Jmin/Jmax if you want junk-packet obfuscation - a real
    // WireGuard peer like Cloudflare's tolerates those fine, just not
    // H1-H4/S1-S4/I1-I5 (those change the actual handshake bytes, which
    // only another AmneziaWG-aware peer would understand). Then select its
    // Tag from any Routing Rule.
    // {
    //   "tag": "WRAP",
    //   "protocol": "freedom",
    //   "settings": {
    //     "domainStrategy": "UseIPv4"
    //   },
    //   "sendThrough": "172.16.0.2"
    // },
    
    // {
    //   "tag": "localhost-tgproxy", "protocol": "freedom", "settings": {"redirect": "127.0.0.1:1001"}
    // },
    // {
    //   "tag": "localhost-faketls", "protocol": "freedom", "settings": {"redirect": "127.0.0.1:1002" }
    // },
    // {
    //   "tag": "other-sni", "protocol": "freedom", "settings": {"redirect": "127.0.0.1:445"}
    // },
    {
      // A DNS Cache can be setup and added here to imporve performance (the corresponding rule should be uncommented)
      "tag": "DNS-Internal",
      "protocol": "dns",
      "settings": {
        "port": 53
      }
    }
    {% set extra = hconfigs.get('additional_configs_xrayjson','') | from_json %}
    {% for ob in extra.get('outbounds', []) %}
    ,{{ ob | tojson }}
    {% endfor %}
  ]
}