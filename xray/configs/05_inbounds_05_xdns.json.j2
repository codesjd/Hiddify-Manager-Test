{# Not gated by core_type: unlike the shared xhttp/ws/grpc streams (gated
   to avoid duplicating what sing-box already serves as the "primary"
   core), Xray itself always runs regardless of core_type (see
   install.sh), and finalmask/xdns has no sing-box equivalent at all - a
   domain in xdns mode needs this inbound generated no matter which core
   is set as primary. #}
{
    "inbounds": [
        {% for d in domains if d['mode']=='xdns' %}
            {% set port = d['internal_port_xdns'] %}
            {
                "tag": "xdnsin_{{port}}",
                {# dnstm's DNS router (see other/dnstt/dnstm_configs/config.json.j2)
                   owns port 53 and forwards this domain's raw DNS-tunnel
                   packets here over loopback - this inbound never needs to
                   be reachable from outside the host directly. #}
                "listen": "127.0.0.1",
                "port": {{port}},
                {% set protocol='vless' %}
                {% with flow="" %}
                    {% include '/opt/hiddify-manager/xray/configs/common/protocols/'~protocol~'.pj2' %},
                {% endwith %}
                "streamSettings": {
                    {# xdns's own docs: MTU is too small for QUIC/xhttp - pair
                       with mKCP. This is a dedicated inbound, never the
                       shared xhttp/ws/grpc one every other domain uses, so
                       the finalmask below only ever changes the wire format
                       for this domain's own tunnel. #}
                    "network": "mkcp",
                    "kcpSettings": {
                        "mtu": 500,
                        "tti": 20,
                        "uplinkCapacity": 5,
                        "downlinkCapacity": 20,
                        "congestion": false
                    },
                    {# Real Xray-core JSON schema (transport/internet/finalmask/xdns/
                       server.go's NewConnServer, verified against v26.6.1 source -
                       common/packages.lock pins this Xray-core version now). The
                       server side only ever needs "domains" (plural) - NewConnServer
                       hard-errors "empty domains" if missing, and never even looks
                       at "resolvers" (that's parsed client-side only, see
                       hutils/proxy/xrayjson.py's add_mask_finalmask_stream()). An
                       earlier v26.3.27-only "domain" (singular) field was removed
                       in a later Xray-core release ("The feature domain has been
                       removed and migrated to domains(server) & resolvers(client)")
                       - this mask's config schema has already broken backwards
                       compatibility once, so keep the server's pinned Xray-core
                       version and any client apps roughly in sync going forward. #}
                    "finalmask": {
                        "udp": [
                            {
                                "type": "xdns",
                                "settings": {
                                    "domains": ["{{d.domain}}"]
                                }
                            }
                        ]
                    }
                },
                "sniffing": {
                    "enabled": false
                }
            },
        {% endfor %}
    ]
}
