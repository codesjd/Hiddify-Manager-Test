# To see all variables please see 'config.env' file
# copy the variables you want from 'config.env' and add to the end of this file

USER_SECRET=      # 32 hex secret for user
MAIN_DOMAIN=      # a subdomain or main domain that is pointed to your server

# DB_BACKEND=mysql  # Valid: mysql (default), postgres, timescaledb, sqlite (low-RAM option)
# HIDDIFY_PROFILE=lite  # Valid: standard (default), lite (disables optional daemons like dnstt, telegram, ssfaketls by default)

# Optional:
TELEGRAM_AD_TAG=  # AD TAG for telegram proxy 
