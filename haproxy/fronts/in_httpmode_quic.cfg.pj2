frontend in-httpmode-quic
  {# Each domain can set its own exclusive TLS port (Domain.tls_port,
     default 443 when unset) - same list as sni_proxy.cfg.pj2's TCP/TLS
     front. 443 is always included so the panel + client Alt-Svc h3
     advertisement stay reachable. #}
  {% for port in (["443"] + (domains | selectattr('tls_port') | map(attribute='tls_port') | map('string') | list)) | unique %}
  bind quic4@:{{port}},quic6@:{{port}} v4v6 tfo ssl crt /opt/hiddify-manager/ssl/ alpn h3
  {%endfor%}

  mode http
  

  acl is_naive req.hdr(hiddify-naive-secret) -m str /{{hconfigs["path_naive"]}}{{hconfigs["path_tcp"]}}

  http-response set-header Alt-Svc 'h3=":443"; ma=2592000,h3-29=":443"; ma=2592000'
    
  #multimap not supported use trick
  #use_backend %[hdr(:authority),map_dom(/opt/hiddify-manager/haproxy/maps/http_domain)]
  #use_backend %[path,map_beg(/opt/hiddify-manager/haproxy/maps/path_h2)]

  http-request set-var(txn.backend) req.hdr(host),map_dom(/opt/hiddify-manager/haproxy/maps/http_domain,default)
  http-request set-var(txn.backend) path,map_beg(/opt/hiddify-manager/haproxy/maps/path_v10,nginx_dispatcher_http_h2) if  { var(txn.backend) -m str default }
  

  use_backend naive_quic if is_naive

  {# Per-domain TLS port exclusivity - mirrors sni_proxy.cfg.pj2/
     in_tcpmode.cfg.pj2. A domain with a custom (non-443) tls_port is only
     reachable on that port over h3 too. #}
  {% for d in domains if d['tls_port'] and d['tls_port']|int != 443 %}
  http-request deny if { hdr(host) -i {{d['domain']}} } !{ dst_port {{d['tls_port']}} }
  {%endfor%}
  {% for d in domains if not d['tls_port'] or d['tls_port']|int == 443 %}
  http-request deny if { hdr(host) -i {{d['domain']}} } !{ dst_port 443 }
  {%endfor%}

  use_backend %[var(txn.backend)]


  default_backend nginx_dispatcher_http_h2