[Unit]
Description=Hiddify Redis
After=network.target
Documentation=http://redis.io/documentation, man:redis-server(1)

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /opt/hiddify-manager/other/redis/redis.conf --supervised systemd --daemonize no
PIDFile=/var/run/hiddify-redis-server.pid
TimeoutStopSec=0
# systemd's default TimeoutStartSec (90s) can be too tight on a fresh
# install: many other services are starting/reloading concurrently and
# redis's sd_notify(READY=1) call can be delayed past it under that
# I/O/CPU contention, which systemd then reports as a failed start -
# Restart=always retries, but each attempt can hit the same contention
# and it can take several cycles before one lands inside the window.
TimeoutStartSec=180
Restart=always
# Redis backs both the Flask session store and the entire hconfig()/
# get_hconfigs() cache layer - unlike xray/singbox, where a crash only
# takes down proxying, losing Redis breaks the whole panel (every
# request either fails to load/save its session or falls through to a
# live DB query). Its own memory is hard-capped at 48mb with an LRU
# eviction policy (see redis.conf's maxmemory), so it can never itself
# be the cause of memory pressure - only ever an innocent bystander -
# which makes full OOM immunity safe here, unlike giving it to a
# service whose memory usage isn't bounded.
OOMScoreAdjust=-1000
User=redis
Group=redis
RuntimeDirectory=hiddify-redis
RuntimeDirectoryMode=2755

UMask=007
PrivateTmp=yes
LimitNOFILE=65535
PrivateDevices=yes
ProtectHome=yes
ReadOnlyDirectories=/
ReadWritePaths=-/var/lib/redis
ReadWritePaths=-/var/log/redis
ReadWritePaths=-/var/run/redis
ReadWritePaths=-/opt/hiddify-manager/other/redis
ReadWritePaths=-/opt/hiddify-manager/log/system

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETGID CAP_SETUID CAP_SYS_RESOURCE
MemoryDenyWriteExecute=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# redis-server can write to its own config file when in cluster mode so we
# permit writing there by default. If you are not using this feature, it is
# recommended that you replace the following lines with "ProtectSystem=full".
ProtectSystem=true
ReadWriteDirectories=-/etc/redis

[Install]
WantedBy=multi-user.target
