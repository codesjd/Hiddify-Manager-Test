# pppd CHAP/MSCHAPv2 credentials. Rendered by common/jinja.py -> chap-secrets,
# then run.sh copies it to /etc/ppp/chap-secrets. Covers both roles:
#
# Inbound (gated on l2tp_enable, same reasoning as ipsec.conf.j2/
# xl2tpd.conf.j2): one line per active Hiddify user (`users` is the same
# active-users list every other subsystem's template iterates -
# all_configs_for_cli() already drops expired/over-quota accounts, so a
# disabled user simply loses their line on the next Apply Configs). Each
# user authenticates with their UUID as BOTH username and password - Hiddify
# users have no separate L2TP username/password, and the UUID is already the
# per-user secret the rest of the panel keys on. The `*` server column
# matches any pppd `name`, and the trailing `*` lets xl2tpd assign the client
# any address from its pool.
#
# Outbound: one line per enabled Outbound row with Protocol=l2tp
# (l2tp_outbounds, see routing.get_l2tp_client_outbounds) - this is OUR
# credential presented to the remote LNS, keyed to that row's own
# `remotename` (its l2tp_interface, set in the peer options file run.sh.j2
# writes) rather than `*`, so it can't be confused with the inbound lines
# above or with another outbound row's credentials.
# client	server	secret	IP addresses
{% if hconfigs['l2tp_enable'] %}
{% for u in users %}
{{ u['uuid'] }}	*	{{ u['uuid'] }}	*
{%- endfor %}
{% endif %}
{% for ob in l2tp_outbounds %}
"{{ ob.username }}"	{{ ob.interface }}	"{{ ob.password }}"	*
{% endfor %}
