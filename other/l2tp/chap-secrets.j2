# pppd CHAP/MSCHAPv2 credentials, one line per active Hiddify user. Rendered
# by common/jinja.py -> chap-secrets, then run.sh copies it to
# /etc/ppp/chap-secrets. `users` here is the same active-users list every
# other subsystem's template iterates (all_configs_for_cli() already drops
# expired/over-quota accounts), so a disabled user simply loses their line
# on the next Apply Configs.
#
# Each user authenticates with their UUID as BOTH username and password -
# Hiddify users have no separate L2TP username/password, and the UUID is
# already the per-user secret the rest of the panel keys on. The `*` server
# column matches any pppd `name`, and the trailing `*` lets xl2tpd assign
# the client any address from its pool.
# client	server	secret	IP addresses
{% for u in users %}
{{ u['uuid'] }}	*	{{ u['uuid'] }}	*
{%- endfor %}
