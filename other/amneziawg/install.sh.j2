source /opt/hiddify-manager/common/utils.sh
source ./awg_utils.sh

# sing-box has no native AmneziaWG support (verified against hiddify-sing-box's
# source directly - no Jc/Jmin/Jmax/amnezia anywhere in it), so this runs as
# its own standalone WireGuard-family interface, the same way WARP runs its
# own wg-quick@warp interface via other/warp/wireguard/. sing-box's outbound
# just binds to whatever interface this brings up (bind_interface), same
# mechanism as WARP - no core-level protocol support needed.
#
# Two upstream projects, neither ships prebuilt Linux binaries as of writing:
#   - amneziawg-tools: C, provides `awg`/`awg-quick` (forks of wg/wg-quick)
#     and an awg-quick@.service systemd template.
#   - amneziawg-go: Go, userspace WireGuard-family implementation. awg-quick
#     tries `ip link add type amneziawg` (a kernel module essentially no
#     stock cloud kernel has) first and automatically falls back to
#     amneziawg-go in PATH if that fails - so no kernel module/DKMS build is
#     needed, just this binary.
#
# Both used to be git-cloned from amnezia-vpn's GitHub and compiled here on
# every install - a dependency on GitHub being reachable (plus a C/Go
# toolchain) that doesn't hold on every VPS/ISP, and needlessly slow given
# neither project changes often. Statically-linked amd64/arm64 binaries are
# now vendored directly under bin/ instead - built via
# .github/workflows/build-amneziawg.yaml from a pinned upstream tag (see
# bin/<arch>/BUILD_INFO.txt for the exact tag/commit/workflow run); refresh
# by re-running that workflow and replacing bin/'s contents, not by editing
# this file.
#
# This same install (jinja-rendered, unlike the plain-bash version this file
# used to be) also brings up "hiddifyawg", a second, independent awg-quick
# interface used for genuine client-facing AmneziaWG connections (Proxy rows
# with proto=amneziawg) - one shared interface for every user, mirroring
# other/wireguard/install.sh.j2's hiddifywg almost exactly, just built on
# amneziawg-go/awg-quick instead of the in-kernel wireguard module so the
# server can enforce Jc/Jmin/Jmax obfuscation against real clients.

case "$(uname -m)" in
    x86_64) AWG_ARCH=amd64 ;;
    aarch64) AWG_ARCH=arm64 ;;
    *) echo "AmneziaWG: unsupported architecture $(uname -m), skipping install" >&2; exit 0 ;;
esac
AWG_BIN_DIR="$(pwd)/bin/$AWG_ARCH"

SYSTEMD_UNIT_DIR="$(pkg-config --variable=systemdsystemunitdir systemd 2>/dev/null || echo /usr/lib/systemd/system)"

install -m 755 "$AWG_BIN_DIR/awg" /usr/bin/awg || exit 1
install -m 755 "$AWG_BIN_DIR/awg-quick" /usr/bin/awg-quick || exit 2
install -m 755 "$AWG_BIN_DIR/amneziawg-go" /usr/bin/amneziawg-go || exit 3
install -d "$SYSTEMD_UNIT_DIR"
install -m 644 "$AWG_BIN_DIR/awg-quick.target" "$SYSTEMD_UNIT_DIR/awg-quick.target" || exit 4
install -m 644 "$AWG_BIN_DIR/awg-quick@.service" "$SYSTEMD_UNIT_DIR/awg-quick@.service" || exit 5
systemctl daemon-reload

mkdir -p /etc/amnezia/amneziawg
chmod 660 -R /etc/amnezia/amneziawg/

{% if hconfigs["amneziawg_client_enable"] %}
SERVER_PUB_NIC="$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)"
SERVER_AWG_IPV4="{{hconfigs["amneziawg_ipv4"]}}"
SERVER_AWG_IPV6="{{hconfigs["amneziawg_ipv6"]}}"
SERVER_PORT={{hconfigs["amneziawg_port"]}}
SERVER_PRIV_KEY={{hconfigs["amneziawg_private_key"]}}

systemctl stop "awg-quick@${SERVER_AWG_NIC}" >/dev/null 2>&1

echo "[Interface]
Address = ${SERVER_AWG_IPV4}/16,${SERVER_AWG_IPV6}/90
ListenPort = ${SERVER_PORT}
PrivateKey = ${SERVER_PRIV_KEY}
{% if hconfigs["amneziawg_jc"] %}Jc = {{hconfigs["amneziawg_jc"]}}
{% endif %}{% if hconfigs["amneziawg_jmin"] %}Jmin = {{hconfigs["amneziawg_jmin"]}}
{% endif %}{% if hconfigs["amneziawg_jmax"] %}Jmax = {{hconfigs["amneziawg_jmax"]}}
{% endif %}{% if hconfigs["amneziawg_h1"] %}H1 = {{hconfigs["amneziawg_h1"]}}
{% endif %}{% if hconfigs["amneziawg_h2"] %}H2 = {{hconfigs["amneziawg_h2"]}}
{% endif %}{% if hconfigs["amneziawg_h3"] %}H3 = {{hconfigs["amneziawg_h3"]}}
{% endif %}{% if hconfigs["amneziawg_h4"] %}H4 = {{hconfigs["amneziawg_h4"]}}
{% endif %}{% if hconfigs["amneziawg_s1"] %}S1 = {{hconfigs["amneziawg_s1"]}}
{% endif %}{% if hconfigs["amneziawg_s2"] %}S2 = {{hconfigs["amneziawg_s2"]}}
{% endif %}{% if hconfigs["amneziawg_s3"] %}S3 = {{hconfigs["amneziawg_s3"]}}
{% endif %}{% if hconfigs["amneziawg_s4"] %}S4 = {{hconfigs["amneziawg_s4"]}}
{% endif %}{% if hconfigs["amneziawg_i1"] %}I1 = {{hconfigs["amneziawg_i1"]}}
{% endif %}{% if hconfigs["amneziawg_i2"] %}I2 = {{hconfigs["amneziawg_i2"]}}
{% endif %}{% if hconfigs["amneziawg_i3"] %}I3 = {{hconfigs["amneziawg_i3"]}}
{% endif %}{% if hconfigs["amneziawg_i4"] %}I4 = {{hconfigs["amneziawg_i4"]}}
{% endif %}{% if hconfigs["amneziawg_i5"] %}I5 = {{hconfigs["amneziawg_i5"]}}
{% endif %}
PostUp = iptables -I INPUT -p udp --dport ${SERVER_PORT} -j ACCEPT
PostUp = iptables -I FORWARD -i ${SERVER_PUB_NIC} -o ${SERVER_AWG_NIC} -j ACCEPT
PostUp = iptables -I FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostUp = ip6tables -I FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostUp = ip6tables -t nat -A POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostDown = iptables -D INPUT -p udp --dport ${SERVER_PORT} -j ACCEPT
PostDown = iptables -D FORWARD -i ${SERVER_PUB_NIC} -o ${SERVER_AWG_NIC} -j ACCEPT
PostDown = iptables -D FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostDown = ip6tables -D FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostDown = ip6tables -t nat -D POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE" >"/etc/amnezia/amneziawg/${SERVER_AWG_NIC}.conf"
chmod 600 "/etc/amnezia/amneziawg/${SERVER_AWG_NIC}.conf"

echo "net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1" >/etc/sysctl.d/awg.conf

if [ "$MODE" != "docker" ]; then
    sysctl --system >/dev/null
fi

systemctl start "awg-quick@${SERVER_AWG_NIC}"
systemctl enable "awg-quick@${SERVER_AWG_NIC}"
{% else %}
# Client-facing interface disabled (or never turned on) - make sure it isn't
# left running from a previous config, but leave the outbound-chaining
# awg{id} interfaces (handled by run.sh.j2 below) untouched.
systemctl disable --now "awg-quick@${SERVER_AWG_NIC}" >/dev/null 2>&1
rm -f "/etc/amnezia/amneziawg/${SERVER_AWG_NIC}.conf"
{% endif %}
