{
  "outbounds": [
    {
      "tag": "freedom",
      "type": "direct"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "WARP",
      "type": "direct",
      "bind_interface": "warp"
    },
    // Add an outbound with Protocol "amneziawg" on the Outbounds admin page
    // to bind to the interface other/amneziawg/ brings up (requires
    // amneziawg_enable + a pasted config in Settings) - same as building a
    // WARP-style bind_interface outbound above, just user-defined instead
    // of hardcoded, so the tag/routing is fully under admin control instead
    // of colliding with a fixed one here.
    {% set extra = hconfigs.get('additional_configs_singbox','') | from_json %}
    {% for ob in extra.get('outbounds', []) %}
    {{ ob | tojson }},
    {% endfor %}
