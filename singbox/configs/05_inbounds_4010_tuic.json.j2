{
	{% if hconfigs['tuic_enable'] %}
		"inbounds": [
			{% for d in domains if d['internal_port_tuic']  %}
			{%set domain=d['domain']%}
			{%set port=d['internal_port_tuic']%}

			{
				"type": "tuic",
				"tag": "tuic_in_{{port}}",
				"listen": "::",
				"listen_port": {{ port }},
				"tcp_fast_open": true,
				"sniff": true,
				"sniff_override_destination": true,
				"domain_strategy": "prefer_ipv4",
				"users": [
					{% for u in users %}
						{"name": "{{ u['uuid'] }}@hiddify.com", "uuid": "{{ u['uuid'] }}", "password": "{{ u['uuid'] }}"},
					{% endfor%}
				],
				"congestion_control": "{{ hconfigs['tuic_congestion_control'] or 'cubic' }}",
				"auth_timeout": "3s",
				"zero_rtt_handshake": true,
				"heartbeat": "10s",
				{%set _tls_domain=domain%}
				{%set _tls_alpn=["h3"]%}
				{%set _tls_min_version="1.2"%}
				{%set _tls_max_version="1.3"%}
				{% include '/opt/hiddify-manager/singbox/configs/common/includes/tls_inbound.pj2' %}
			},
			{%endfor%}
		]
	{% endif %}
}
